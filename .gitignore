# Active .gitignore for the foundation repo itself.
# Derived from .ai-workspace/templates/gitignore-template.md and extended for the
# runnable harness layer. A project that COPIES this foundation should derive its
# own .gitignore from the template, not reuse this one verbatim.

# === Secrets (top, broad) ===
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets/
credentials/
**/password*
**/api-key*
**/api_key*
**/auth-token*

# === Local Claude Code overrides (committed: settings.json + *.example) ===
.claude/settings.local.json

# === Automation run-markers (per-machine, ephemeral; never committed) ===
.claude/.onboarding-state.json
.claude/.daily_maintenance_last
.claude/.compact_nudge_state
.claude/.session_state_guard

# === Python build / packaging ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# === Virtual environments ===
.venv/
venv/
env/

# === Test / lint / type caches ===
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# === Harness run artifacts (ephemeral skill/engine outputs) ===
.uaw-runs/

# === OS cruft ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor cruft ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Governance lifecycle (ephemeral / draft zones) ===
.ai-workspace/scratch/
.ai-workspace/research/_drafts/

# === Working / scratch docs (local only, never published) ===
optimierungen-harness.md

# === Kit-Hygiene: ungetrackte Liste echter Klarnamen fuer den Pre-Release-Scan ===
# Wird von den optionalen .githooks/ gelesen. Enthaelt PII -> nie committen.
.private-scan-terms

# === Optionale Projekt-Deny-Liste fuer external_content_guard (kann PII enthalten) ===
# Eine Zeile pro Term; vom opt-in Hook gelesen. Repo liefert keine. Un-ignore nur wenn PII-frei.
.claude/external-content-denylist.txt
