{
  "description": "UAW memory hooks for Codex (D-2026-09-30-07). Same scripts as Claude Code under .claude/hooks/, gated by .claude/automation.flags.json. Codex asks you to review and trust each hook via /hooks before it runs. No matcher: SessionStart fires for startup/resume/clear/compact, PreCompact for manual/auto.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/run.sh\" now_init.py --tool codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/run.sh\" memory_boot.py --tool codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/run.sh\" journal_stub.py --tool codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/run.sh\" precompact_reminder.py --tool codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
