{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup", "hooks": [
        { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/boot_reload.py\"" },
        { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/first_run_onboarding.py\"" },
        { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/daily_maintenance.py\"" }
      ] },
      { "matcher": "resume", "hooks": [
        { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/boot_reload.py\"" },
        { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/daily_maintenance.py\"" }
      ] },
      { "matcher": "clear",   "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/boot_reload.py\"" } ] },
      { "matcher": "compact", "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/boot_reload.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|NotebookEdit", "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/recitation_nudge.py\"" } ] }
    ]
  }
}
